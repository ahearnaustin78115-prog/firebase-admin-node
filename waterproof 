import android.app.Application
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import com.renter.budgeting.data.BudgetItemEntity
import com.renter.budgeting.data.RentBudgetDatabase
import com.renter.budgeting.data.RentBudgetRepository
import com.renter.budgeting.data.RentPaymentEntity
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.stateIn
import kotlinx.coroutines.launch
import java.util.Calendar

class RentBudgetViewModel(application: Application) : AndroidViewModel(application) {

    private val repository: RentBudgetRepository

    init {
        val database = RentBudgetDatabase.getDatabase(application)
        repository = RentBudgetRepository(database)
    }

    // Current selected year and month key state (e.g., for 2026 and "2026-10")
    val currentYear: Int = Calendar.getInstance().get(Calendar.YEAR)
    val currentMonthKey: String = "2026-10" // Can be dynamically calculated or passed

    // Reactive StateFlow for Rent Payments of the current year
    val rentPayments: StateFlow<List<RentPaymentEntity>> = repository
        .getRentLogForYear(currentYear)
        .stateIn(
            scope = viewModelScope,
            started = SharingStarted.WhileSubscribed(5000),
            initialValue = emptyList()
        )

    // Reactive StateFlow for Budget Items of the current month
    val budgetItems: StateFlow<List<BudgetItemEntity>> = repository
        .getBudgetItems(currentMonthKey)
        .stateIn(
            scope = viewModelScope,
            started = SharingStarted.WhileSubscribed(5000),
            initialValue = emptyList()
        )

    // --- Actions ---

    fun saveRentPayment(payment: RentPaymentEntity) {
        viewModelScope.launch {
            repository.saveRentPayment(payment)
        }
    }

    fun deleteRentPayment(payment: RentPaymentEntity) {
        viewModelScope.launch {
            repository.deleteRentPayment(payment)
        }
    }

    fun updateBudgetItem(item: BudgetItemEntity) {
        viewModelScope.launch {
            repository.updateBudgetItem(item)
        }
    }

    fun seedDefaultTemplate(rentAmount: Double) {
        viewModelScope.launch {
            repository.seedDefaultBudgetTemplate(currentMonthKey, rentAmount)
        }
    }
}
